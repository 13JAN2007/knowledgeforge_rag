# ─────────────────────────────────────────────
# KnowledgeForge AI — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Application
APP_NAME="KnowledgeForge AI"
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# PostgreSQL
POSTGRES_USER=knowledgeforge
POSTGRES_PASSWORD=knowledgeforge_secret
POSTGRES_DB=knowledgeforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=knowledgeforge_chunks

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Sentence Transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
